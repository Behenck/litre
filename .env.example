# Driver de persistência: 'sqlite' ou 'supabase'.
# Contas, login e confirmação de e-mail só existem no driver 'supabase'.
LITRO_DB_DRIVER=sqlite

# Caminho do arquivo SQLite (relativo à raiz do projeto).
LITRO_DB_PATH=data/litro.db

# Necessárias somente com LITRO_DB_DRIVER=supabase. A secret key é exclusiva do
# servidor: nunca use prefixo NEXT_PUBLIC_ nem a importe em Client Components.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Segredo que assina os tokens de sessão (JWT). Mínimo de 32 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor derruba todas as sessões abertas.
LITRO_JWT_SECRET=

# Endereço público do app — é a base do link no e-mail de confirmação.
LITRO_APP_URL=http://localhost:3000

# Envio do e-mail de confirmação.
# O remetente padrão (onboarding@resend.dev) só entrega para o e-mail dono da
# conta no Resend; para enviar a qualquer pessoa, verifique um domínio e troque
# LITRO_MAIL_FROM.
RESEND_API_KEY=re_xxx
LITRO_MAIL_FROM=Litre <onboarding@resend.dev>
